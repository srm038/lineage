\newcommand\childlist[4][\hfill{}]{
  \begin{minipage}[t]{\parindent}\flushleft
    \ifthenelse{\equal{#1}{+}}{\hyperref[x#2]{#1}\iin{#2}}{\hfill{}}
  \end{minipage}
  \begin{minipage}[t]{\parindent}\flushright
    \ifthenelse{\equal{#1}{+}}{\labelcref{#2}}{\hfill{}}
  \end{minipage}
  \begin{minipage}[t]{1.5\parindent}\flushright
    \childno
  \end{minipage}
  \begin{minipage}[t]{0.5\parindent}
    \hfill{}
  \end{minipage}
  \begin{minipage}[t]{\textwidth-5\parindent}
    \ifthenelse{\equal{#1}{+}}{\hyperref[x#2]{\textsc{#3}}}{\textsc{#3}}\ifthenelse{\equal{#4}{.}}{.}{, #4}
  \end{minipage}%\ifthenelse{\equal{#1}{+}}{\iin{#2}}{}

}

